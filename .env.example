# Digital Penang LMS — copy to .env / Dokploy Environment
# After updating image settings, wipe old Frappe-only data:
#   docker compose down -v && docker compose pull && docker compose up -d

SITE_NAME=lms.iyazbrhm.cloud
FRAPPE_SITE_NAME_HEADER=lms.iyazbrhm.cloud

ADMIN_PASSWORD=changeme-strong-admin-password
DB_ROOT_PASSWORD=changeme-strong-db-root-password

# MUST be the custom image (includes payments + lms). Do not use ghcr.io/frappe/lms alone.
IMAGE_NAME=amirul123/lms-custom
VERSION=latest
PULL_POLICY=always

HTTP_PUBLISH_PORT=8090

DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000

UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
