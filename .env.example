# Digital Penang LMS — copy to .env for local runs, or paste into Dokploy Environment

# Site / domain (must match Dokploy domain + DNS A record)
SITE_NAME=lms.iyazbrhm.cloud
FRAPPE_SITE_NAME_HEADER=lms.iyazbrhm.cloud

# Credentials — change these before first deploy
ADMIN_PASSWORD=changeme-strong-admin-password
DB_ROOT_PASSWORD=changeme-strong-db-root-password

# Frappe LMS image (pin v2.52.0 — newer stable tags may omit the LMS app)
IMAGE_NAME=ghcr.io/frappe/lms
VERSION=v2.52.0
PULL_POLICY=always
INSTALL_APP_ARGS=--install-app lms

# Database / Redis (defaults match compose service names)
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000

# Proxy / upload tuning (behind Dokploy Traefik)
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
