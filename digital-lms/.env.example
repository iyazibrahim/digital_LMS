MONGODB_URI=mongodb://127.0.0.1:27017/digital-lms
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production HTTPS: COOKIE_SECURE=1 — local HTTP: COOKIE_SECURE=0
COOKIE_SECURE=0

# Auto-created on first DB connect. Leave a role blank to skip seeding it.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_INSTRUCTOR_EMAIL=
SEED_INSTRUCTOR_PASSWORD=
SEED_INSTRUCTOR_NAME=
SEED_STUDENT_EMAIL=
SEED_STUDENT_PASSWORD=
SEED_STUDENT_NAME=
# Set to 1 to force-reset admin password from ENV on next boot
SEED_RESET_ADMIN_PASSWORD=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email (Resend) — password reset & notifications
RESEND_API_KEY=
EMAIL_FROM=Digital Penang LMS <onboarding@resend.dev>

# Google / Microsoft SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# AI quiz drafts (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
